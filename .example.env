AUTH_USER_SOURCE = "example@example.ru" # impersonation source mail admin
PASSWORD_SOURCE = "superpass_source" # impersonation source mail admin password
AUTH_USER_TARGET = "example@example.org" # impersonation target mail admin
PASSWORD_TARGET = "superpass_target" # impersonation target mail admin password

SOURCE_SERVER = "mail.example.ru" # source mail server
TARGET_SERVER = "mail.example.org" # target mail server
PORT_SOURCE = 993 # source mail server port IMAP
PORT_TARGET = 993 # target mail server port IMAP